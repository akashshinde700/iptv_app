<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Display name + version (xtool fills in the bundle id / executable) -->
  <key>CFBundleDisplayName</key>
  <string>StreamKaro</string>
  <key>CFBundleShortVersionString</key>
  <string>0.5.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>

  <!-- Which website the native shell loads. Change this to your deployment,
       or override it at runtime from the in-app "Server settings" screen. -->
  <key>StreamKaroBaseURL</key>
  <string>https://www.streamkaro.aetherdevsolutions.in</string>

  <!-- IPTV: plenty of channels are still plain http. WKWebView needs this
       exception for web content; native requests stay https-only. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoadsInWebContent</key>
    <true/>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>

  <!-- Video: portrait for browsing, landscape for watching. -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <!-- Keeps audio (and Picture-in-Picture) alive when the viewer leaves the app. -->
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
  </array>

  <!-- Status bar stays light-on-dark over the app's own theme. -->
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <false/>
  <key>UIStatusBarStyle</key>
  <string>UIStatusBarStyleLightContent</string>
  <key>UIStatusBarHidden</key>
  <false/>

  <!-- streamkaro://watch/123 opens in-app. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.streamkaro.app</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>streamkaro</string>
      </array>
    </dict>
  </array>

  <!-- No custom cryptography — answers App Store Connect's export question. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>

  <key>LSApplicationCategoryType</key>
  <string>public.app-category.entertainment</string>
</dict>
</plist>
