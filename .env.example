# Copy to .env and fill in. Never commit .env.
#
# Complete list: every variable the code actually reads is documented here.
#   `npm run typecheck` + `npm test` prove nothing about the environment — a missing one of these
#   is how a "working" build fails on a fresh server (e.g. no ADMIN_PASSWORD → a randomly
#   generated owner password printed once into a log nobody kept).

# ── Database ─────────────────────────────────────────────────────────────
# MySQL 8+. Create the schema first:  CREATE DATABASE iptv_saas;
DATABASE_URL="mysql://user:password@localhost:3306/iptv_saas"

# ── Security secrets (required) ──────────────────────────────────────────
# 64 hex chars each:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating PROXY_SIGNING_SECRET invalidates every signed stream URL already handed out (players
# re-request and get fresh ones, so the impact is a brief re-buffer).
PROXY_SIGNING_SECRET=
# Encrypts portal passwords (Xtream/Stalker/XTREAM credentials) at rest. Losing this makes every
# stored portal credential unreadable — back it up with the database.
PORTAL_ENC_KEY=

# ── Public URL (required behind a proxy / CDN) ───────────────────────────
# Absolute origin used in generated playlist URLs and share links. Without it, a deployment behind
# nginx/CDN generated playlists full of http://localhost:3000 links that no TV could open.
# PUBLIC_BASE_URL=https://tv.example.com

# ── Multi-tenancy ────────────────────────────────────────────────────────
# The root (single-operator) organization slug. Must exist in the database — the seed creates it.
# ROOT_ORG_SLUG=root
# Storefront subdomains hang off this domain: <slug>.example.com (comma-separated list allowed).
# STOREFRONT_BASE_DOMAIN=streamkaro.app,streamkaro.com
# Same value, exposed to the browser (used by the client to build storefront links).
# NEXT_PUBLIC_STOREFRONT_BASE_DOMAIN=streamkaro.app

# ── First-run admin (strongly recommended) ───────────────────────────────
# Owner password for `scripts/seed-admin.ts`. If unset, a random one is generated and printed ONCE.
# In production the seed refuses weak or historically-known values.
# ADMIN_PASSWORD=
# ADMIN_EMAIL=owner@example.com

# ── Demo data (development only) ─────────────────────────────────────────
# The seed creates a `testuser` customer. In production it is skipped unless you force it.
# SEED_TEST_CUSTOMER=1
# SEED_CUSTOMER_PASSWORD=test1234
# Legacy alias for ADMIN_PASSWORD.
# SEED_ADMIN_PASSWORD=

# ── Monetization (optional) ────────────────────────────────────────────
NEXT_PUBLIC_UPI_VPA=demo@upi
NEXT_PUBLIC_UPI_NAME=StreamKaro
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# ── Media hub (optional) ────────────────────────────────────────────────
# Default provider is your own Xtream catalog. Leave these unset unless you know why.
# MEDIA_PROVIDER=catalog        # catalog | nxsha
# NXSHA_ENABLED=false           # ⚠️ third-party, unlicensed aggregator — see docs/MEDIA_HUB.md
# NXSHA_BASE=https://…          # nxsha backend origin
# NXSHA_AES_KEY=…               # nxsha transport key
# MEDIA_FIXTURES=1              # sample catalog for UI work with NO database (dev only —
#                               # refused outright when NODE_ENV=production)

# ── Automatic stream health checks (recommended) ────────────────────────
# Set this, then schedule: curl -fsS -X POST https://your-host/api/cron/health -H "authorization: Bearer $CRON_SECRET"
# Without it the cron endpoint refuses to run (503). Admin → Auto-fix still works manually.
# The same run also reconciles lapsed plans, so scheduling it is what keeps "expired" honest.
CRON_SECRET=

# ── One-off migration helpers (leave unset normally) ─────────────────────
# LEGACY_SQLITE=…               # path of a legacy SQLite file, for scripts/migrate-sqlite-to-mysql.ts
# MIGRATE_SESSIONS=1            # migrate old session rows during that import
# ORG_SLUG=…                    # target org slug for one-off scripts

# ── Desktop app (build time) ─────────────────────────────────────────────
# Which site the Electron shell loads. Overridable per launch via the environment.
# STREAMKARO_URL=https://www.example.com

# ── iOS app: universal links (optional) ─────────────────────────────────
# Only needed if you want https://your-site/... links to open inside the
# native iOS app (ios/, built with xtool). Leave unset to serve 404 at
# /.well-known/apple-app-site-association.
# APPLE_TEAM_ID=ABCDE12345          # 10-char Apple Developer Team ID
# APPLE_BUNDLE_ID=com.streamkaro.app # only if you changed ios/xtool.yml

# ── iOS app: which website the shell loads ──────────────────────────────
# Baked into ios/Support/Info.plist (StreamKaroBaseURL) at build time; the app
# can also be repointed per device from its own Settings screen (https only).
# STREAMKARO_IOS_URL=https://www.streamkaro.aetherdevsolutions.in
