<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom Media3 controller: the exo_* ids are picked up by PlayerControlView, the sk_*
  ids are wired in PlayerActivity. Every control is a focusable button for D-pad remotes.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/sk_player_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/sk_live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/sk_live_badge"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="LIVE"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sk_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/sk_player_bottom_scrim"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="40dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/sk_timebar_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/sk_prev_channel"
                    style="@style/SkPlayerButton"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="10dp"
                    android:text="‹ Previous"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@id/exo_play_pause"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/sk_player_button_bg"
                    android:contentDescription="Play / pause"
                    android:padding="10dp"
                    android:scaleType="fitCenter" />

                <Button
                    android:id="@+id/sk_next_channel"
                    style="@style/SkPlayerButton"
                    android:text="Next ›"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/sk_quality"
                    style="@style/SkPlayerButton"
                    android:text="Quality"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/sk_audio"
                    style="@style/SkPlayerButton"
                    android:text="Audio"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/sk_subtitles"
                    style="@style/SkPlayerButton"
                    android:text="Subtitles"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/sk_zoom"
                    style="@style/SkPlayerButton"
                    android:text="Zoom: Fit" />

                <Button
                    android:id="@+id/sk_frame_rate"
                    style="@style/SkPlayerButton"
                    android:text="Match frame rate: Off"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/sk_stats_toggle"
                    style="@style/SkPlayerButton"
                    android:text="Stats" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</merge>
