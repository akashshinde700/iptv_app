{
  "name": "streamkaro-desktop",
  "productName": "StreamKaro",
  "version": "0.5.0",
  "description": "StreamKaro — live TV, desktop app",
  "main": "main.js",
  "author": "StreamKaro",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.streamkaro.app",
    "productName": "StreamKaro",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StreamKaro",
      "artifactName": "StreamKaro-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "artifactName": "StreamKaro-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Video",
      "artifactName": "StreamKaro-${version}.${ext}"
    }
  }
}
