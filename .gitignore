# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database
/db/
*.sqlite
*.sqlite3
*.db

# deploy artifacts
_deploy_src.tgz
_deploy_files.txt
_desktop.tgz

# desktop app build output
/desktop/node_modules/
/desktop/dist/

# native mobile build output
/android/app/build/
/android/build/
/android/.gradle/
/android/app/release/
/android/local.properties
# iOS: the native xtool project in ios/ IS tracked (see docs/IOS_APP.md).
# Build output inside it stays out of git — see ios/.gitignore.
# (Older Capacitor iOS output, if you ever add one, goes to /ios-capacitor/)

# app binaries (uploaded to the server, not committed)
/public/downloads/*
!/public/downloads/README.txt

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# Secrets & local-only infra (NEVER commit — contain VPS/DB passwords + encryption keys)
deploy.py
deploy_apps.py
__pycache__/
*.pyc

# Legacy local SQLite DB dump (huge; app uses MySQL now)
db/

# generated SQLite twin of the Prisma schema (local dev only)
prisma/schema.sqlite.prisma
